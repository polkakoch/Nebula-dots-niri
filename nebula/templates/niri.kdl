// Nebula · {{name}} — generated by nb-theme, don't edit
layout {
    // instead of a loud focus ring — a thin, barely visible outline;
    // the active window stands out by being opaque (see nebula-settings.kdl)
    focus-ring {
        off
    }
    border {
        active-color "{{fg}}2e"
        inactive-color "{{fg}}14"
        urgent-color "{{red}}cc"
    }
    insert-hint {
        color "{{accent}}40"
    }
    tab-indicator {
        active-color "{{accent}}"
        inactive-color "{{overlay}}"
        urgent-color "{{red}}"
    }
}

overview {
    backdrop-color "{{bg_alt}}"
}
