// Nebula · {{name}} — generated by nb-theme (theme colors + the picture from nb-fetch).
// Picture: nb-fetch set <file> / next / random, or Control Center → Fastfetch.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {{fetch_logo}},
    "display": {
        "separator": "  ",
        "color": {
            "keys": "{{accent}}",
            "title": "{{accent}}",
            "separator": "{{muted}}",
            "output": "{{fg}}"
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "color": { "user": "{{accent}}", "at": "{{muted}}", "host": "{{accent2}}" }
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{overlay.ansi}}m────────────────────────────"
        },
        { "type": "os",       "key": "󰣇  система" },
        { "type": "kernel",   "key": "󰌽  ядро" },
        { "type": "wm",       "key": "󱂬  wm" },
        { "type": "terminal", "key": "󰆍  терминал" },
        { "type": "shell",    "key": "󰞷  shell" },
        { "type": "cpu",      "key": "󰻠  процессор", "keyColor": "{{blue}}" },
        { "type": "gpu",      "key": "󰢮  видео",     "keyColor": "{{blue}}" },
        { "type": "memory",   "key": "󰍛  память",    "keyColor": "{{magenta}}" },
        { "type": "disk",     "key": "󰋊  диск",      "keyColor": "{{magenta}}", "folders": "/" },
        { "type": "uptime",   "key": "󰅐  аптайм",    "keyColor": "{{green}}" },
        { "type": "packages", "key": "󰏖  пакеты",    "keyColor": "{{green}}" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
