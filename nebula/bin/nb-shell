#!/usr/bin/env bash
# Nebula — Search, Control Center, the player and notifications (one resident GTK4 process)
#   nb-shell launcher                 search (again — close)
#   nb-shell panel [wifi|bluetooth|sound|appearance|walls|clip|power|fetch|display|time|bar|desktop|windows|profile]
#   nb-shell media                                     the player under the bar
#   nb-shell welcome                                   the first-time setup wizard
#   nb-shell notify dismiss|clear|restore|dnd|test     notifications
#   nb-shell daemon                                    start the process (done at login)
#   nb-shell restart | quit
# Commands go into the running process's FIFO — no Python startup, so they're instant.
NB_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RT="${XDG_RUNTIME_DIR:-/tmp}/nebula"
FIFO="$RT/shell.fifo"
PIDF="$RT/shell.pid"
mkdir -p "$RT"

alive() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null && [ -p "$FIFO" ]; }
start() { setsid -f python3 "$NB_DIR/shell/main.py" "$@" >>"$RT/shell.log" 2>&1 </dev/null; }

case "$1" in
    daemon)
        alive || start ;;
    restart)
        alive && kill "$(cat "$PIDF")" 2>/dev/null
        for _ in $(seq 30); do alive || break; sleep 0.1; done
        : > "$RT/shell.log"; start ;;
    quit)
        alive && printf 'quit\n' 1<>"$FIFO" ;;
    launcher|panel|media|welcome|theme|settings|notify|notify-changed|hide|query)
        if alive; then
            printf '%s\n' "$*" 1<>"$FIFO"
        else
            case "$1" in theme|settings|notify|notify-changed|hide|query) exit 0 ;; esac
            start --cmd "$*"
        fi ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
