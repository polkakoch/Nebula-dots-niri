#!/usr/bin/env python3
"""Nebula — the player in the middle of the menu bar (waybar).

  nb-media bar [--no-cover]   a long-running custom/media module: "title · artist"
                              (JSON lines); empty when nothing plays, so the module hides
  nb-media cover              path to the current rounded cover (or nothing)

Players are followed over MPRIS (Playerctl), no polling. The cover is the module's CSS background:
when the track changes we drop a rounded picture into ~/.cache/nebula/covers/ and rewrite
waybar/nebula-cover.css, and waybar picks up the style by itself (reload_style_on_change). No
once-a-second polling and no signals (waybar 0.15's image module hangs on them).
One instance at a time: a new one (after waybar restarts) ends the old one; waybar gone — we go too.
"""
import hashlib
import json
import os
import signal
import sys
import threading
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "shell"))
from i18n import tr  # noqa: E402

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "nebula"
COVERS = CACHE / "covers"
STATE = CACHE / "cover.src"     # path to the current cover (empty — none)
CSS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "waybar" / "nebula-cover.css"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "nebula"
ICONS = {"spotify": "󰓇", "firefox": "󰈹", "chromium": "\uf268", "mpv": "󰐹", "vlc": "󰕼"}


def cover_cmd():
    try:
        p = STATE.read_text().strip()
        if p and os.path.exists(p):
            print(p)
    except OSError:
        pass


def single_instance(name, marker):
    """End the old instance (left over after a waybar reload) and register ourselves."""
    RUNTIME.mkdir(parents=True, exist_ok=True)
    pidf = RUNTIME / f"{name}.pid"
    try:
        old = int(pidf.read_text())
        if old != os.getpid() and marker in open(f"/proc/{old}/cmdline", "rb").read():
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    pidf.write_text(str(os.getpid()))


def bar(with_cover=True):
    import gi
    gi.require_version("Playerctl", "2.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GLib, Playerctl

    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    single_instance("nb-media-bar", b"nb-media\0bar")
    write_css(None)   # last session's cover shouldn't pop up without music
    manager = Playerctl.PlayerManager()
    players = {}
    state = {"last": None, "art": None, "cover": False}

    def safe(fn, default=None):
        try:
            return fn()
        except Exception:
            return default

    def current():
        live = [p for p in players.values()
                if safe(lambda p=p: p.props.playback_status) == Playerctl.PlaybackStatus.PLAYING]
        if live:
            return live[0]
        return next(iter(players.values()), None)

    def emit(*_):
        p = current()
        if p is None:
            out = {"text": "", "class": "none"}
            set_art(None)
        else:
            title = safe(p.get_title) or ""
            artist = safe(p.get_artist) or ""
            name = safe(lambda: p.props.player_name, "") or ""
            playing = safe(lambda: p.props.playback_status) == Playerctl.PlaybackStatus.PLAYING
            if not title:
                out = {"text": "", "class": "none"}
            else:
                text = GLib.markup_escape_text(title)
                if artist:
                    text += f"<span alpha='60%'>  ·  {GLib.markup_escape_text(artist)}</span>"
                if not playing:
                    text = f"<span alpha='70%'>󰏤</span>  {text}"
                album = safe(p.get_album) or ""
                tip = f"{ICONS.get(name, '󰎆')}  {name.capitalize()}\n{title}"
                if artist or album:
                    tip += f"\n{artist}{' — ' + album if album else ''}"
                tip += "\n\n" + tr("ЛКМ — большой плеер · ПКМ — пауза · колесо — трек")
                cls = ["playing" if playing else "paused", name]
                if state["cover"]:
                    cls.append("cover")
                out = {"text": text, "tooltip": GLib.markup_escape_text(tip), "class": cls, "alt": name}
            set_art(safe(lambda: p.print_metadata_prop("mpris:artUrl")) or None)
        line = json.dumps(out, ensure_ascii=False)
        if line != state["last"]:
            state["last"] = line
            sys.stdout.write(line + "\n")
            sys.stdout.flush()

    def set_art(url):
        if not with_cover:
            url = None
        if url == state["art"]:
            return
        state["art"] = url

        def work():
            ok = make_cover(url)
            if state["art"] == url:
                GLib.idle_add(lambda: (state.__setitem__("cover", ok), emit()) and False)
        threading.Thread(target=work, daemon=True).start()

    def add(name):
        try:
            p = Playerctl.Player.new_from_name(name)
        except GLib.Error:
            return
        for sig in ("metadata", "playback-status"):
            p.connect(sig, lambda *_: GLib.idle_add(emit))
        manager.manage_player(p)
        players[name.instance] = p
        emit()

    def vanish(_m, player):
        for k, v in list(players.items()):
            if v == player:
                del players[k]
        emit()

    manager.connect("name-appeared", lambda _m, n: add(n))
    manager.connect("player-vanished", vanish)
    for n in manager.props.player_names:
        add(n)
    emit()
    loop = GLib.MainLoop()
    # waybar closed the pipe (restart) — leave instead of hanging around as an orphan
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, 1, GLib.IOCondition.HUP | GLib.IOCondition.ERR,
                          lambda *_: loop.quit() or False)
    loop.run()


def write_css(path):
    """nebula-cover.css: the cover as the #custom-media background (or nothing). Atomic — waybar watches the file."""
    css = (f'#custom-media.cover {{ background-image: url("file://{path}"); }}\n' if path
           else "/* nb-media: no cover */\n")
    try:
        if CSS.exists() and CSS.read_text() == css:
            return
        CSS.parent.mkdir(parents=True, exist_ok=True)
        tmp = CSS.with_suffix(".css.nbtmp")
        tmp.write_text(css)
        os.replace(tmp, CSS)
        STATE.write_text(path or "")
    except OSError:
        pass


def make_cover(url):
    """Fetch/open the cover, round it, put it in covers/ and update the CSS. True if there is one."""
    path = None
    if url:
        try:
            COVERS.mkdir(parents=True, exist_ok=True)
            key = hashlib.md5(url.encode()).hexdigest()
            path = str(COVERS / f"{key}.png")
            if not os.path.exists(path):
                if url.startswith("file://"):
                    src = urllib.parse.unquote(urllib.parse.urlparse(url).path)
                else:
                    d = CACHE / "art"
                    d.mkdir(exist_ok=True)
                    src = str(d / key)
                    if not os.path.exists(src):
                        req = urllib.request.Request(url, headers={"User-Agent": "nebula-shell"})
                        with urllib.request.urlopen(req, timeout=6) as r, open(src + ".tmp", "wb") as f:
                            f.write(r.read())
                        os.replace(src + ".tmp", src)
                rounded(src, path + ".tmp.png", 96, 18)
                os.replace(path + ".tmp.png", path)
            # don't hoard old covers: keep the last 30
            old = sorted(COVERS.glob("*.png"), key=lambda p: p.stat().st_mtime)[:-30]
            for p in old:
                p.unlink(missing_ok=True)
        except Exception:
            path = None
    write_css(path)
    return path is not None


def rounded(src, dst, size, radius):
    import math
    import cairo
    from gi.repository import GdkPixbuf
    pb = GdkPixbuf.Pixbuf.new_from_file(src)
    s = max(size / pb.get_width(), size / pb.get_height())
    w, h = max(1, round(pb.get_width() * s)), max(1, round(pb.get_height() * s))
    pb = pb.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
    if not pb.get_has_alpha():
        pb = pb.add_alpha(False, 0, 0, 0)
    # Pixbuf (RGBA) → cairo ARGB32 (BGRA, premultiplied)
    data = bytearray(pb.get_pixels())
    stride, n = pb.get_rowstride(), pb.get_n_channels()
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    sd, ss = surf.get_data(), surf.get_stride()
    for y in range(h):
        for x in range(w):
            i = y * stride + x * n
            r, g, b, a = data[i], data[i + 1], data[i + 2], data[i + 3]
            j = y * ss + x * 4
            sd[j:j + 4] = bytes((b * a // 255, g * a // 255, r * a // 255, a))
    surf.mark_dirty()
    out = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    cr = cairo.Context(out)
    r = radius
    cr.new_sub_path()
    cr.arc(size - r, r, r, -math.pi / 2, 0)
    cr.arc(size - r, size - r, r, 0, math.pi / 2)
    cr.arc(r, size - r, r, math.pi / 2, math.pi)
    cr.arc(r, r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()
    cr.clip()
    cr.set_source_surface(surf, (size - w) / 2, (size - h) / 2)
    cr.paint()
    out.write_to_png(dst)
    return True


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "bar"
    if cmd == "cover":
        cover_cmd()
    elif cmd == "bar":
        bar(with_cover="--no-cover" not in sys.argv)
    else:
        print(__doc__.strip())
        sys.exit(1)
