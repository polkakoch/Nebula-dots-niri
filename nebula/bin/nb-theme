#!/usr/bin/env bash
# Nebula — the theme engine
#   nb-theme apply <id>     apply a theme (matugen = colors from the wallpaper)
#   nb-theme reload         re-apply the current one
#   nb-theme render [tpl]   only regenerate the files (no app reloads)
#   nb-theme list           id|name|dark/light
#   nb-theme current        id of the current theme
#   nb-theme swatch <id>    path to a palette preview (PNG)
. "$(dirname "$(readlink -f "$0")")/../lib.sh"

TPL_DIR="$NB_DIR/templates"
USER_THEMES="$NB_DIR/themes"
KEYS=(bg bg_alt surface overlay fg fg_dim muted accent accent2 red green yellow blue magenta cyan orange on_accent
      term_black term_bblack term_white term_bwhite)

theme_file() { # path to a theme file by id
    if [ "$1" = matugen ]; then
        gen_matugen && echo "$NB_CACHE/matugen.theme"
    elif [ -f "$USER_THEMES/$1.theme" ]; then
        echo "$USER_THEMES/$1.theme"
    fi
}

# The "From wallpaper" theme: matugen → a Nebula palette
gen_matugen() {
    local wall json
    wall=$(nb_current_wall)
    [ -f "$wall" ] || { echo "matugen: no current wallpaper to take colors from" >&2; return 1; }
    has matugen || { echo "matugen is not installed" >&2; return 1; }
    local out="$NB_CACHE/matugen.theme" stamp="$NB_CACHE/matugen.src"
    # cache: same picture, same scheme — nothing to recalculate
    if [ -f "$out" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$wall|$MATUGEN_SCHEME" ]; then return 0; fi
    json=$(matugen -c "$NB_DIR/matugen.toml" image "$wall" -m dark -t "$MATUGEN_SCHEME" \
        --json hex --dry-run --prefer saturation -q 2>/dev/null) || return 1
    # semantic colors (green, yellow…) come from fixed "seeds", tinted to match the palette
    seed() { matugen -c "$NB_DIR/matugen.toml" color hex "$1" -m dark -t scheme-tonal-spot \
        --json hex --dry-run -q 2>/dev/null | jq -r '.colors.primary.dark.color'; }
    jq -r --arg green "$(seed '#4caf50')" --arg yellow "$(seed '#fbc02d')" --arg blue "$(seed '#2196f3')" \
          --arg magenta "$(seed '#e040fb')" --arg cyan "$(seed '#00bcd4')" --arg orange "$(seed '#ff9800')" '
      def c(k): .colors[k].dark.color;
      "# generated by matugen\nname=\"Из обоев\"\nmode=dark",
      "bg=\(c("surface"))",
      "bg_alt=\(c("surface_container_lowest"))",
      "surface=\(c("surface_container_high"))",
      "overlay=\(c("surface_container_highest"))",
      "fg=\(c("on_surface"))",
      "fg_dim=\(c("on_surface_variant"))",
      "muted=\(c("outline"))",
      "accent=\(c("primary"))",
      "accent2=\(c("tertiary"))",
      "on_accent=\(c("on_primary"))",
      "red=\(c("error"))",
      "green=\($green)", "yellow=\($yellow)", "blue=\($blue)",
      "magenta=\($magenta)", "cyan=\($cyan)", "orange=\($orange)"
    ' <<<"$json" > "$out.tmp" && mv "$out.tmp" "$out" && echo "$wall|$MATUGEN_SCHEME" > "$stamp"
}

hex_rgb() { local h=${1#\#}; printf '%d, %d, %d' 0x"${h:0:2}" 0x"${h:2:2}" 0x"${h:4:2}"; }
hex_csv() { local h=${1#\#}; printf '%d,%d,%d' 0x"${h:0:2}" 0x"${h:2:2}" 0x"${h:4:2}"; }
hex_ansi() { local h=${1#\#}; printf '%d;%d;%d' 0x"${h:0:2}" 0x"${h:2:2}" 0x"${h:4:2}"; }

# The fastfetch logo: the chosen picture (nb-fetch) or a small distro logo.
# A terminal cell is about twice as tall as it is wide, so we work out the width to keep it square
fetch_logo() {
    local img="$NB_CACHE/fetch/logo.png" h=${FETCH_SIZE:-16} w
    w=$(( (h * 217 + 50) / 100 ))
    if [ -s "$img" ]; then
        printf '{ "type": "kitty-direct", "source": "%s", "width": %d, "height": %d, "padding": { "top": 1, "left": 2, "right": 3 } }' "$img" "$w" "$h"
    else
        printf '{ "type": "small", "padding": { "top": 1, "left": 2, "right": 3 } }'
    fi
}
sed_esc() { printf '%s' "$1" | sed 's/[|&\\]/\\&/g'; }

# Loads a theme into variables and builds the sed script that fills in the templates
load_theme() {
    local file="$1"
    # shellcheck source=/dev/null
    . "$file"
    : "${on_accent:=$bg}"
    : "${mode:=dark}"
    # the terminal's ANSI "black"/"white" depend on how light the theme is
    if [ "$mode" = light ]; then
        term_black=$fg; term_bblack=$fg_dim; term_white=$overlay; term_bwhite=$surface
    else
        term_black=$surface; term_bblack=$muted; term_white=$fg_dim; term_bwhite=$fg
    fi
    SED=""
    local k v
    for k in "${KEYS[@]}"; do
        v=${!k}
        SED+="s|{{$k}}|$v|g;s|{{$k.strip}}|${v#\#}|g;s|{{$k.rgb}}|$(hex_rgb "$v")|g;s|{{$k.csv}}|$(hex_csv "$v")|g;s|{{$k.ansi}}|$(hex_ansi "$v")|g;"
    done
    local icons="Papirus-Dark" gtk="prefer-dark"
    [ "$mode" = light ] && icons="Papirus-Light" && gtk="prefer-light"
    SED+="s|{{name}}|$(sed_esc "$(t "$name")")|g;s|{{mode}}|$mode|g;s|{{icon_theme}}|$icons|g;"
    SED+="s|{{wallpaper}}|$(sed_esc "$(nb_current_wall)")|g;s|{{home}}|$(sed_esc "$HOME")|g;"
    SED+="s|{{fetch_logo}}|$(sed_esc "$(fetch_logo)")|g;"
    GTK_SCHEME=$gtk
}

render_all() { # [template] — just that one template (hyprlock.conf, for example)
    local src dst only="$1"
    while read -r src dst; do
        [[ -z "$src" || "$src" == \#* ]] && continue
        [ -n "$only" ] && [ "$src" != "$only" ] && continue
        [ -f "$TPL_DIR/$src" ] || continue
        mkdir -p "$(dirname "$NB_CONF/$dst")"
        if [ "$NB_LANG" = ru ]; then
            sed "$SED" "$TPL_DIR/$src" > "$NB_CONF/$dst.nbtmp"
        else    # templates are written in Russian; captions like fastfetch's keys get swapped
            sed "$SED" "$TPL_DIR/$src" | python3 "$NB_DIR/shell/localize.py" "$NB_LANG" - > "$NB_CONF/$dst.nbtmp"
        fi && mv -f "$NB_CONF/$dst.nbtmp" "$NB_CONF/$dst"
    done < "$TPL_DIR/targets"
}

# Qt/KDE apps (Dolphin…) go through KDE integration (QT_QPA_PLATFORMTHEME=kde) and take their
# colors from the [Colors:*] groups in ~/.config/kdeglobals. We swap only those groups and the
# scheme name — style, fonts, icons and everything else stay as they were
kde_colors() {
    local src="$NB_CONF/nebula/cache/kdeglobals.colors" kg="$NB_CONF/kdeglobals"
    [ -f "$src" ] || return 0
    touch "$kg"
    {
        awk '/^\[/ { skip = ($0 ~ /^\[(Colors:|WM\])/) } !skip' "$kg" \
            | sed -e 's/^ColorScheme=.*/ColorScheme=Nebula/' -e :a -e '/^\n*$/{$d;N;ba' -e '}'
        echo; grep -v '^#' "$src"
    } > "$kg.nbtmp" && mv -f "$kg.nbtmp" "$kg"
    grep -q '^\[General\]' "$kg" || printf '\n[General]\nColorScheme=Nebula\n' >> "$kg"
}

reload_apps() {
    [ -n "$NB_NO_RELOAD" ] && return 0
    # waybar re-reads its styles by itself (reload_style_on_change, @imports included) —
    # no SIGUSR2, or it would restart every one of its modules
    has makoctl && makoctl reload 2>/dev/null
    # niri watches its config and includes by itself
    # the volume/brightness pills and the shell (Search, Control Center) get the new colors
    local f
    for f in "$NB_RUNTIME"/pill-*.fifo; do [ -p "$f" ] && { printf 'theme\n' 1<>"$f"; } 2>/dev/null; done
    "$NB_DIR/bin/nb-shell" theme 2>/dev/null
    pkill -USR1 -x kitty 2>/dev/null
    # running KDE apps re-read the palette from kdeglobals on the fly
    has dbus-send && dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:0 int32:0 2>/dev/null
    has gsettings && gsettings set org.gnome.desktop.interface color-scheme "$GTK_SCHEME" 2>/dev/null
    has gsettings && gsettings set org.gnome.desktop.interface icon-theme "$( [ "$GTK_SCHEME" = prefer-light ] && echo Papirus-Light || echo Papirus-Dark)" 2>/dev/null
}

# Palette preview: 5 colored dots on the theme's background
swatch() {
    local id="$1" file out
    out="$NB_CACHE/swatches/$id.png"
    if [ "$id" = matugen ]; then   # "From wallpaper" previews the current wallpaper
        local w; w=$(nb_current_wall)
        if [ -n "$w" ] && [ -s "$(nb_thumb_path "$w")" ]; then nb_thumb_path "$w"; else echo preferences-desktop-wallpaper; fi
        return
    fi
    file=$(theme_file "$id") || return 1
    [ -n "$file" ] || return 1
    if [ -f "$out" ] && [ "$out" -nt "$file" ]; then echo "$out"; return; fi
    mkdir -p "$NB_CACHE/swatches"
    (
        . "$file"
        magick -size 160x160 xc:none \
            -fill "$bg" -stroke "$overlay" -strokewidth 3 -draw "roundrectangle 2,2 157,157 36,36" -stroke none \
            -fill "$accent"  -draw "circle 54,58 54,32" \
            -fill "$accent2" -draw "circle 106,58 106,32" \
            -fill "$red"     -draw "circle 44,114 44,98" \
            -fill "$green"   -draw "circle 80,114 80,98" \
            -fill "$yellow"  -draw "circle 116,114 116,98" \
            "$out" 2>/dev/null
    )
    echo "$out"
}

list_themes() {
    local f id
    for f in "$USER_THEMES"/*.theme; do
        id=$(basename "$f" .theme)
        ( . "$f"; printf '%s|%s|%s\n' "$id" "$name" "${mode:-dark}" )
    done
    printf 'matugen|%s|dynamic\n' "$(t "Из обоев")"
}

apply() {
    local id="${1:-$(nb_current_theme)}" quiet="$2" file
    file=$(theme_file "$id")
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        nb_notify "$(t "Тема не найдена")" "$id" dialog-error
        return 1
    fi
    load_theme "$file"
    render_all
    kde_colors
    echo "$id" > "$NB_STATE/theme"
    reload_apps
    [ "$quiet" = "--quiet" ] || nb_notify "$(t "Тема применена")" "$(t "$name")" preferences-desktop-theme
}

case "$1" in
    apply)   apply "$2" "$3" ;;
    reload)  apply "$(nb_current_theme)" --quiet ;;
    render)  f=$(theme_file "$(nb_current_theme)") && [ -n "$f" ] && load_theme "$f" && render_all "$2" ;;
    list)    list_themes ;;
    current) nb_current_theme ;;
    swatch)  swatch "$2" ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
