#!/usr/bin/env bash
# Nebula — turns Control Center settings into configs for niri, waybar and nb-shell
#   nb-settings apply [all|niri|waybar]   regenerate the files
#   nb-settings set <KEY> <value>         write to settings.conf and apply
#   nb-settings get <KEY>                 the current value
#   nb-settings bar-layout "<left>" "<center>" "<right>"   menu bar modules
#   nb-settings localize                  captions in the installed configs → current language
#
# niri:   ~/.config/niri/nebula-settings.kdl          (niri re-reads it by itself)
# waybar: ~/.config/waybar/nebula-settings.{jsonc,css} (+ a restart if the modules changed)
# nb-shell (frame, Dock, desktop clock) gets the "settings" command
. "$(dirname "$(readlink -f "$0")")/../lib.sh"

DOCK_H=70   # Dock height without the frame — for "always visible" (windows sit above it)

atomic() { # <file> — stdin into the file, never leaving it half-written
    mkdir -p "$(dirname "$1")"
    cat > "$1.nbtmp" && mv -f "$1.nbtmp" "$1"
}

frame_px() { if [ "$BAR_STYLE" = frame ]; then echo "${FRAME_SIZE:-8}"; else echo 0; fi; }

# module id from the settings → waybar module name (defined in waybar/config.jsonc)
mod_name() {
    case "$1" in
        logo) echo custom/logo ;;          workspaces) echo niri/workspaces ;;
        window) echo niri/window ;;        media) echo custom/media ;;
        tray) echo tray ;;                 volume) echo custom/volume ;;
        brightness) echo custom/brightness ;; language) echo niri/language ;;
        network) echo network ;;           bluetooth) echo bluetooth ;;
        battery) echo battery ;;           cpu) echo cpu ;;
        memory) echo memory ;;             control) echo custom/control ;;
        clock) echo clock ;;               power) echo custom/power ;;
    esac
}
json_modules() { # "logo workspaces" → ["custom/logo", "niri/workspaces"]
    local out="" m n
    for m in $1; do
        n=$(mod_name "$m")
        [ -n "$n" ] && out="$out${out:+, }\"$n\""
    done
    printf '[%s]' "$out"
}

kb_layouts() { # "us, ru" → "us,ru"; junk is dropped, nothing at all → us
    local l; l=$(printf '%s' "${KB_LAYOUTS:-us,ru}" | tr -d ' ' | tr -cd 'a-z0-9,()_-')
    echo "${l:-us}"
}
kb_options() { # only when there's more than one layout
    case "$(kb_layouts)" in *,*) ;; *) return 0 ;; esac
    case "${KB_SWITCH:-caps}" in
        caps)       echo "grp:caps_toggle" ;;
        alt_shift)  echo "grp:alt_shift_toggle" ;;
        ctrl_shift) echo "grp:ctrl_shift_toggle" ;;
        ralt)       echo "grp:toggle" ;;
    esac
}

gen_niri() {
    local slowdown t bottom
    slowdown=$(awk -v s="${ANIM_SPEED:-1}" 'BEGIN { if (s <= 0) s = 1; printf "%.3f", 1 / s }')
    t=$(frame_px); bottom=$t
    [ "${DOCK:-autohide}" = always ] && bottom=$(( t + DOCK_H ))
    {
        echo "// Nebula — generated by nb-settings from settings.conf (Control Center → Settings)."
        echo "// Please don't edit: put your own tweaks in conf.d/user.kdl"
        echo "layout {"
        echo "    gaps ${WIN_GAPS:-10}"
        echo "    border {"
        if [ "${WIN_BORDER:-1}" = 1 ]; then echo "        on"; else echo "        off"; fi
        echo "        width 1"
        echo "    }"
        echo "    // the frame around the screen (nb-shell) and the Dock: windows stay clear of them"
        echo "    struts {"
        echo "        left $t"
        echo "        right $t"
        echo "        top 0"
        echo "        bottom $bottom"
        echo "    }"
        echo "}"
        echo
        echo "animations {"
        if [ "${ANIM_ENABLED:-1}" = 1 ]; then echo "    slowdown $slowdown"; else echo "    off"; fi
        echo "}"
        echo
        echo "window-rule {"
        echo "    geometry-corner-radius ${WIN_RADIUS:-14}"
        echo "    clip-to-geometry true"
        echo "}"
        if [ "${ECO:-0}" = 1 ]; then
            echo
            echo "// battery saver: no blur under windows and panels, inactive windows opaque"
            echo "window-rule {"
            echo "    background-effect {"
            echo "        blur false"
            echo "    }"
            echo "}"
            echo "layer-rule {"
            echo "    background-effect {"
            echo "        blur false"
            echo "    }"
            echo "}"
        elif awk -v o="${WIN_OPACITY:-1}" 'BEGIN { exit !(o < 0.999) }'; then
            echo
            echo "// inactive windows a little see-through, the active one fully opaque"
            echo "window-rule {"
            echo "    match is-active=false"
            echo '    exclude app-id=r#"^(mpv|vlc|org\.gnome\.Totem|steam_app_.*|gamescope)$"#'
            echo "    opacity ${WIN_OPACITY}"
            echo "}"
        fi
        if [ "${WIN_MAXIMIZED:-1}" = 1 ]; then
            echo
            echo "// new windows open at full width (Super+Shift+F — back to normal)"
            echo "window-rule {"
            echo "    open-maximized true"
            echo "}"
        fi
        echo
        case "$BAR_STYLE" in
            floating)
                echo "// floating menu bar: blurred glass with rounded corners"
                echo "layer-rule {"
                echo '    match namespace="^waybar$"'
                echo "    geometry-corner-radius 14"
                echo "}" ;;
            classic)
                echo "// classic menu bar: full width, translucent, blurred (the rule is in rules.kdl)" ;;
            *)
                echo "// the menu bar is solid (frame) or transparent (pills, islands, notch, minimal) — no blur needed"
                echo "layer-rule {"
                echo '    match namespace="^waybar$"'
                echo "    background-effect {"
                echo "        blur false"
                echo "    }"
                echo "}" ;;
        esac
        echo
        echo "// keyboard, mouse and touchpad (Control Center → Input)"
        echo "input {"
        echo "    keyboard {"
        echo "        xkb {"
        echo "            layout \"$(kb_layouts)\""
        [ -n "$(kb_options)" ] && echo "            options \"$(kb_options)\""
        echo "        }"
        echo "    }"
        echo "    touchpad {"
        [ "${TP_TAP:-1}" = 1 ] && echo "        tap"
        [ "${TP_NATURAL:-1}" = 1 ] && echo "        natural-scroll"
        echo "        dwt"
        echo "        accel-speed ${TP_SPEED:-0.15}"
        echo "        scroll-factor ${TP_SCROLL:-0.7}"
        echo '        click-method "clickfinger"'
        echo "    }"
        echo "    mouse {"
        echo '        accel-profile "flat"'
        echo "        accel-speed ${MOUSE_SPEED:-0}"
        [ "${MOUSE_NATURAL:-0}" = 1 ] && echo "        natural-scroll"
        echo "    }"
        [ "${FOCUS_FOLLOWS:-1}" = 1 ] && echo '    focus-follows-mouse max-scroll-amount="0%"'
        echo "}"
        echo
        if [ "${CLAUDE:-0}" = 1 ]; then
            echo "binds {"
            echo "    // the Claude add-on"
            echo '    Mod+Shift+C repeat=false hotkey-overlay-title="Claude" { spawn-sh "~/.config/nebula/bin/nb-claude open"; }'
            echo '    Mod+Ctrl+Shift+C repeat=false hotkey-overlay-title="'"$(t "Claude: продолжить разговор")"'" { spawn-sh "~/.config/nebula/bin/nb-claude continue"; }'
            echo "}"
        fi
        echo
        echo "// hot corner: push the cursor there for an overview of every window"
        echo "gestures {"
        echo "    hot-corners {"
        case "${HOT_CORNER:-top-left}" in
            top-left|top-right|bottom-left|bottom-right) echo "        $HOT_CORNER" ;;
            *) echo "        off" ;;
        esac
        echo "    }"
        echo "}"
    } | atomic "$NB_CONF/niri/nebula-settings.kdl"
}

gen_waybar() {
    local t fmt alt interval=60 h=${BAR_HEIGHT:-34} mt=0 ms=0 cover_flag=""
    [ "${BAR_MEDIA_COVER:-1}" = 1 ] || cover_flag=" --no-cover"
    [ -f "$NB_CONF/waybar/nebula-cover.css" ] || echo "/* nb-media: no cover */" > "$NB_CONF/waybar/nebula-cover.css"
    if [ "${CLOCK_24H:-1}" = 1 ]; then t="%H:%M"; else t="%I:%M"; fi
    [ "${CLOCK_SECONDS:-0}" = 1 ] && t="$t:%S" && interval=1
    if [ "${CLOCK_DATE:-1}" = 1 ]; then fmt="%a %d %b  $t"; alt="$t"
    else fmt="$t"; alt="%A, %d %B  $t"; fi
    case "$BAR_STYLE" in
        floating) mt=8; ms=10 ;;
        pills|islands) mt=6; ms=8 ;;
        minimal)  mt=2; ms=6 ;;
    esac
    cat <<EOF | atomic "$NB_CONF/waybar/nebula-settings.jsonc"
// Nebula — generated by nb-settings (Control Center → Menu bar / Date and time)
{
    "height": $h,
    "margin-top": $mt,
    "margin-left": $ms,
    "margin-right": $ms,
    "modules-left": $(json_modules "$BAR_LEFT"),
    "modules-center": $(json_modules "$BAR_CENTER"),
    "modules-right": $(json_modules "$BAR_RIGHT"),
    "custom/media": {
        "exec": "~/.config/nebula/bin/nb-media bar$cover_flag",
        "return-type": "json",
        "escape": false,
        "max-length": ${BAR_MEDIA_LEN:-40},
        "restart-interval": 3,
        "on-click": "~/.config/nebula/bin/nb-shell media",
        "on-click-right": "playerctl play-pause",
        "on-click-middle": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "clock": {
        "format": "{:$fmt}",
        "format-alt": "{:$alt}",
        "interval": $interval
    }
}
EOF
    {
        echo "/* Nebula — generated by nb-settings: menu bar style \"$BAR_STYLE\" */"
        case "$BAR_STYLE" in
            frame) cat <<'EOF'
window#waybar { background: @bg; border: none; border-radius: 0; }
EOF
            ;;
            floating) cat <<'EOF'
window#waybar {
    background: alpha(@bg, 0.62);
    border: 1px solid alpha(@fg, 0.08);
    border-radius: 14px;
}
EOF
            ;;
            pills) cat <<'EOF'
window#waybar { background: transparent; }
/* every module is its own pill */
window#waybar .modules-left > widget > *,
window#waybar .modules-center > widget > *,
window#waybar .modules-right > widget > * {
    background: alpha(@bg, 0.86);
    border: 1px solid alpha(@fg, 0.08);
    border-radius: 999px;
    margin: 2px 3px;
    padding: 0 12px;
}
window#waybar .modules-left > widget > *:hover,
window#waybar .modules-center > widget > *:hover,
window#waybar .modules-right > widget > *:hover { background: alpha(@bg, 0.97); }
window#waybar .modules-left > widget > .expanded,
window#waybar .modules-right > widget > .expanded { background: mix(@bg, @accent, 0.25); }
window#waybar.empty #window, window#waybar .hidden {
    background: transparent; border: none; padding: 0; margin: 0;
}
EOF
            ;;
            minimal) cat <<'EOF'
window#waybar { background: transparent; }
window#waybar label { text-shadow: 0 1px 4px alpha(black, 0.55); }
EOF
            ;;
            classic) cat <<'EOF'
/* Classic: full width, translucent, blurred underneath */
window#waybar {
    background: alpha(@bg, 0.55);
    border-bottom: 1px solid alpha(@fg, 0.07);
    border-radius: 0;
}
EOF
            ;;
            islands) cat <<'EOF'
window#waybar { background: transparent; }
/* three islands: left, center, right; an empty island disappears */
window#waybar .modules-left,
window#waybar .modules-center,
window#waybar .modules-right {
    background: alpha(@bg, 0.86);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px alpha(@fg, 0.07);
}
EOF
            ;;
            notch) cat <<'EOF'
window#waybar { background: transparent; }
window#waybar .modules-left label, window#waybar .modules-right label {
    text-shadow: 0 1px 4px alpha(black, 0.55);
}
/* the center "hangs" from the top edge: a solid tab with a rounded bottom;
 * the block itself has no padding — when the center is empty (no music), it's 0 wide and the tab is gone */
window#waybar .modules-center { background: @bg; border-radius: 0 0 16px 16px; }
window#waybar .modules-center > widget > * { margin: 0; padding-left: 14px; padding-right: 14px; }
EOF
            ;;
        esac
        # the cover is the player module's background: room for it on the left, sized to the bar height
        echo "window#waybar #custom-media.cover { padding-left: $(( h - 14 + 14 ))px; background-size: $(( h - 14 ))px $(( h - 14 ))px; }"
    } | atomic "$NB_CONF/waybar/nebula-settings.css"
}

# Restart rather than SIGUSR2: after USR2 waybar leaves old modules and zombie processes behind.
# If the generated config didn't change, leave it alone entirely (it re-reads CSS by itself).
reload_waybar() {
    [ -n "$NB_NO_RELOAD" ] && return 0
    local sum f="$NB_CONF/waybar/nebula-settings.jsonc" st="$NB_RUNTIME/waybar.sum"
    sum=$(md5sum "$f" 2>/dev/null | cut -d' ' -f1)
    [ -n "$sum" ] && [ "$sum" = "$(cat "$st" 2>/dev/null)" ] && pgrep -x waybar >/dev/null && return 0
    echo "$sum" > "$st"
    pgrep -x waybar >/dev/null || return 0      # not running (installing from a tty) — don't start it
    pkill -x waybar 2>/dev/null
    for _ in $(seq 30); do pgrep -x waybar >/dev/null || break; sleep 0.05; done
    if command -v niri >/dev/null && niri msg version >/dev/null 2>&1; then
        niri msg action spawn -- waybar >/dev/null 2>&1
    else
        setsid -f waybar >/dev/null 2>&1
    fi
}
notify_shell() { [ -n "$NB_NO_RELOAD" ] || "$NB_DIR/bin/nb-shell" settings 2>/dev/null; }

# Put captions inside the installed configs into the current language: niri hotkey titles,
# waybar tooltips, the lock screen, Dolphin menus, fastfetch labels.
localize() {
    local f files=() wb="$NB_CONF/waybar/config.jsonc"
    for f in "$NB_CONF"/niri/conf.d/*.kdl "$wb" "$NB_CONF/hypr/hyprlock.conf" \
             "${XDG_DATA_HOME:-$HOME/.local/share}/kio/servicemenus/nebula.desktop"; do
        [ -f "$f" ] && files+=("$f")
    done
    python3 "$NB_DIR/shell/localize.py" "$NB_LANG" "${files[@]}"
    # Russian day and month names in the bar clock need the ru_RU locale; without it the module won't start
    if [ -f "$wb" ]; then
        if [ "$NB_LANG" = ru ] && locale -a 2>/dev/null | grep -qiE '^ru_RU\.utf-?8$'; then
            sed -i 's|^\([[:space:]]*\)// *"locale": "ru_RU.UTF-8",|\1"locale": "ru_RU.UTF-8",|' "$wb"
        else
            sed -i 's|^\([[:space:]]*\)"locale": "ru_RU.UTF-8",|\1// "locale": "ru_RU.UTF-8",|' "$wb"
        fi
    fi
    [ "${CLAUDE:-0}" = 1 ] && "$NB_DIR/bin/nb-claude" servicemenu
    NB_NO_RELOAD=1 "$NB_DIR/bin/nb-theme" render 2>/dev/null
    return 0
}

case "$1" in
    apply)
        case "${2:-all}" in
            niri)   gen_niri ;;
            waybar) gen_waybar; reload_waybar ;;
            *)      gen_niri; gen_waybar; reload_waybar; notify_shell ;;
        esac ;;
    set)
        [ -n "$2" ] || exit 1
        nb_set "$2" "$3"
        [ "$2" = FRAME ] && { [ "$3" = 1 ] && BAR_STYLE=frame || BAR_STYLE=floating; nb_set BAR_STYLE "$BAR_STYLE"; }
        case "$2" in
            WIN_*|ANIM_*|TP_*|MOUSE_*|FOCUS_*|HOT_*|KB_*)  gen_niri ;;
            CLAUDE)        gen_niri; "$NB_DIR/bin/nb-claude" servicemenu ;;
            CLOCK_*)       gen_waybar; reload_waybar; notify_shell ;;
            BAR_STYLE|FRAME*|DOCK) gen_niri; gen_waybar; reload_waybar; notify_shell ;;
            BAR_*)         gen_waybar; reload_waybar; notify_shell ;;
            ECO)           gen_niri ;;
            DESKTOP_*|DESK_*) notify_shell ;;
            NOTIF_*)       notify_shell ;;
            UI_LANG)       # everything that shows text has to be rebuilt in the new language
                           . "$NB_DIR/lib.sh"
                           localize; gen_niri; gen_waybar
                           [ -n "$NB_NO_RELOAD" ] || {
                               "$NB_DIR/bin/nb-shell" restart
                               pkill -x waybar; sleep 0.3
                               niri msg action spawn -- waybar >/dev/null 2>&1 || setsid -f waybar >/dev/null 2>&1
                           } ;;
            NOTIFY)        # hand notifications over to mako, or take them back
                           [ -n "$NB_NO_RELOAD" ] || {
                               "$NB_DIR/bin/nb-shell" restart
                               [ "$3" = 1 ] || { sleep 1; pgrep -x mako >/dev/null || setsid -f mako >/dev/null 2>&1; }
                           } ;;
            CLAUDE_DOLPHIN) "$NB_DIR/bin/nb-claude" servicemenu ;;
        esac ;;
    bar-layout) # bar-layout "<left>" "<center>" "<right>" — all the modules in one go
        nb_set BAR_LEFT "$2"; nb_set BAR_CENTER "$3"; nb_set BAR_RIGHT "$4"
        gen_waybar; reload_waybar ;;
    localize) localize ;;
    get) [ -n "$2" ] && printf '%s\n' "${!2}" ;;
    *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
